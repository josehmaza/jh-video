<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla completa del video (como las apps de video para auto): tapa todo menos la tira de volumen
     de la izquierda (72dp), porque el auto no tiene botones físicos.
     Un toque muestra u oculta los controles; doble toque sale -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutVideoFs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="72dp"
    android:layout_marginLeft="72dp"
    android:background="#000000"
    android:visibility="gone">

    <TextureView
        android:id="@+id/videoTextureFs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tapa el video mientras no llega un cuadro del archivo actual (si no, se ve el del anterior) -->
    <LinearLayout
        android:id="@+id/layoutFsPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivFsNoVideo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_video_placeholder" />
    </LinearLayout>

    <!-- Solo audio: tapa la imagen en negro (no encandila de noche); el audio sigue. Encima, un "Solo audio"
         muy tenue para saber por qué está negro. No recibe toques: pasan al video -->
    <FrameLayout
        android:id="@+id/layoutFsAudioOnly"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Solo audio"
            android:textColor="#33ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Aviso del monitor (antes en la barra de arriba): cartel oscuro arriba al centro, debajo del foco y del ☰.
         Texto naranja, rojo si es grave; dura lo que el aviso (6 s). No recibe toques -->
    <TextView
        android:id="@+id/tvFsAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_video_alert"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#f59e0b"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Controles encima del video: se ocultan solos a los 3 s mientras se reproduce -->
    <LinearLayout
        android:id="@+id/layoutFsControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Arriba: título, solo audio (foco, al centro), menú ☰ y salir de pantalla completa.
             Título y botones de la derecha pesan igual: así el foco queda justo al centro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fs_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvFsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:shadowColor="#b3000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:singleLine="true"
                android:textColor="#ffffff"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Solo audio (foco): pone la imagen en negro; aparece con los demás controles -->
            <ImageButton
                android:id="@+id/btnFsAudioOnly"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_fs_btn"
                android:contentDescription="Solo audio: imagen en negro"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bulb" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

            <!-- Menú ☰ (aleatorio y repetir): aparece con los demás controles -->
            <ImageButton
                android:id="@+id/btnFsMenu"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_fs_btn"
                android:contentDescription="Opciones de reproducción"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu" />

            <ImageButton
                android:id="@+id/btnFsExit"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_fs_btn"
                android:contentDescription="Salir de pantalla completa"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fs_exit" />
            </LinearLayout>
        </LinearLayout>

        <!-- Debajo del título, a la izquierda: repetir y aleatorio encendidos (solo aviso, no se tocan) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivFsModeRepeat"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_ctrl_repeat"
                android:tint="@color/accent_cyan"
                android:visibility="gone"
                android:contentDescription="Repetir video encendido" />

            <ImageView
                android:id="@+id/ivFsModeShuffle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_ctrl_shuffle"
                android:tint="@color/accent_cyan"
                android:visibility="gone"
                android:contentDescription="Aleatorio encendido" />
        </LinearLayout>

        <!-- Centro libre: ahí se toca para mostrar u ocultar los controles -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Abajo: barra de progreso que se arrastra, tiempo y controles -->
        <LinearLayout
            android:id="@+id/layoutFsBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fs_bottom"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="20dp"
            android:paddingBottom="6dp">

            <!-- Zona de toque de 34dp de alto (fácil de acertar con el dedo); la barra que se ve mide 8dp -->
            <SeekBar
                android:id="@+id/seekFsProgress"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:max="1000"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_fs_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_fs_thumb"
                android:thumbOffset="10dp" />

            <!-- Fila de tiempo y ayuda: arriba de los botones para no quitarles ancho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFsTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="00:00 / 00:00"
                    android:textColor="#e2e8f0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Un toque: controles · Doble toque: salir"
                    android:textColor="#99ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Fila de controles idéntica a JH MUSIC: íconos blancos sin caja del tamaño del ícono (74dp, el círculo cian
                 de bg_ctrl_icon solo se ve detrás del botón). La zona de toque llega hasta el borde de la pantalla porque
                 la decide navZoneAt() por la posición del dedo, no el tamaño del botón (estirados, el círculo era un óvalo) -->
            <LinearLayout
                android:id="@+id/layoutFsNavZone"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnFsPrev"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_ctrl_icon"
                    android:contentDescription="Anterior"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ctrl_prev" />

                <ImageButton
                    android:id="@+id/btnFsPlay"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_ctrl_play"
                    android:contentDescription="Reproducir / Pausar"
                    android:elevation="6dp"
                    android:padding="22dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ctrl_play" />

                <ImageButton
                    android:id="@+id/btnFsNext"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_ctrl_icon"
                    android:contentDescription="Siguiente"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ctrl_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
