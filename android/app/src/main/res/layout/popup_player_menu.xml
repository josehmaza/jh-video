<?xml version="1.0" encoding="utf-8"?>
<!-- Menú ☰ del video (igual que JH MUSIC, sin la fila del explorador): cubre el reproductor o la pantalla
     completa con un fondo oscuro; tocar fuera lo cierra.
     Filas altas (72dp) con ON / OFF escrito, para tocar manejando -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8c000000"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_player_menu"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Opciones"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menuClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_player_menu_close"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:padding="13dp"
                android:contentDescription="Cerrar" />
        </LinearLayout>

        <!-- Aleatorio -->
        <LinearLayout
            android:id="@+id/menuShuffle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/bg_player_menu_row"
            android:clickable="true">

            <ImageView
                android:id="@+id/menuShuffleIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_ctrl_shuffle"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menuShuffleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aleatorio"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Mezcla el orden de la lista"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuShuffleState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="58dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_player_menu_state"
                android:fontFamily="monospace"
                android:text="OFF"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Repetir canción -->
        <LinearLayout
            android:id="@+id/menuRepeat"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/bg_player_menu_row"
            android:clickable="true">

            <ImageView
                android:id="@+id/menuRepeatIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_ctrl_repeat"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menuRepeatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repetir video"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Vuelve a empezar al terminar"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuRepeatState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="58dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_player_menu_state"
                android:fontFamily="monospace"
                android:text="OFF"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Re-escanear USB (antes en la barra de arriba): es una acción, cierra el menú. La app igual
             escanea sola al conectar o quitar un pendrive -->
        <LinearLayout
            android:id="@+id/menuRescan"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/bg_player_menu_row"
            android:clickable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_rescan"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Re-escanear USB"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Buscar videos nuevos en los pendrives"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Versión instalada (antes en la barra de arriba) -->
        <TextView
            android:id="@+id/menuVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
