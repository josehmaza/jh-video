<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutTreeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingEnd="8dp"
    android:background="@drawable/bg_tree_node"
    android:descendantFocusability="blocksDescendants">

    <!-- Espaciador dinámico según nivel de profundidad (indent) -->
    <View
        android:id="@+id/viewIndent"
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <!-- Flecha de Despliegue (> o v) o Punto si no tiene hijos -->
    <ImageView
        android:id="@+id/ivTreeArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:scaleType="centerInside"
        android:layout_marginEnd="6dp" />

    <!-- Cuadro con Icono (USB verde o Carpeta azul) -->
    <FrameLayout
        android:id="@+id/frameTreeIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_tree_icon_folder"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/ivTreeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tree_folder" />
    </FrameLayout>

    <!-- Título de la Carpeta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvTreeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Nombre Carpeta"
            android:textColor="#f8fafc"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- + : agregar la carpeta entera a Mi Mix (solo si tiene canciones directas) -->
    <ImageButton
        android:id="@+id/btnTreeAddMix"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_folder_addmix"
        android:src="@drawable/ic_mix_add"
        android:scaleType="center"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:contentDescription="Agregar carpeta a Mi Lista" />

    <!-- Botón Reproducir Carpeta [ N ▶ ] (Solo si tiene canciones directas) -->
    <LinearLayout
        android:id="@+id/btnFolderPlay"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_folder_play_btn"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvTreeDirectCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="7dp" />

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_white_circle">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_triangle" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
