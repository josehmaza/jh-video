<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador de volumen al deslizar: círculo grande centrado en toda la pantalla (igual que JH LAUNCHER) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blindVolumeHud"
    android:layout_width="220dp"
    android:layout_height="220dp"
    android:layout_gravity="center"
    android:background="@drawable/bg_blind_volume_hud"
    android:elevation="30dp"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:id="@+id/ivBlindHudIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_vol_on"
        android:tint="@color/accent_cyan" />

    <TextView
        android:id="@+id/tvBlindHudPercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="75%"
        android:textColor="#f1f5f9"
        android:textSize="56sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hud_track">

        <View
            android:id="@+id/viewBlindHudFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_hud_fill" />
    </FrameLayout>
</LinearLayout>
